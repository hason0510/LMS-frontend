{
  "permissions": {
    "allow": [
      "Bash(npx playwright:*)",
      "Bash(npm list:*)"
    ],
    "allowedTools": [
      "Bash(.claude/skills/ck/ck *)",
      "Bash(.claude\\skills\\ck\\ck.cmd *)"
    ]
  },
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/agent-usage-guard.sh",
            "type": "command"
          },
          {
            "command": "bash -c 'command -v pwsh >/dev/null 2>&1 && pwsh -NonInteractive -File .claude/hooks/agent-usage-guard.ps1 || exit 0'",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/ck-update-check.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c 'command -v pwsh >/dev/null 2>&1 && pwsh -NonInteractive -File .claude/hooks/ck-update-check.ps1 || exit 0'",
            "timeout": 15
          }
        ],
        "matcher": "startup"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/ck-scope-hint.sh",
            "type": "command"
          },
          {
            "command": "bash -c 'command -v pwsh >/dev/null 2>&1 && pwsh -NonInteractive -File .claude/hooks/ck-scope-hint.ps1 || exit 0'",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/ck-bash-guard.sh",
            "type": "command"
          },
          {
            "command": "bash -c 'command -v pwsh >/dev/null 2>&1 && pwsh -NonInteractive -File .claude/hooks/ck-bash-guard.ps1 || exit 0'",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
